---
all:
  hosts    {% for ip in instance_ips %}
    host_{{ loop.index }}:
      ansible_host: {{ ip }}
      ansible_user: centos
      ansible_ssh_private_key_file: {{ ssh_private_key_path }}
    {% endfor %}
  children:
    webservers:
      hosts:
        {% for ip in instance_ips %}
        host_{{ loop.index }}:
        {% endfor %}
        