all:
  children:
    web:
      hosts:
%{ for vm in web_vms ~}
        ${vm.name}:
          ansible_host: ${vm.network_interface[0].nat_ip_address}
          fqdn: ${vm.fqdn}
%{ endfor ~}
    mon:
      hosts:
%{ for vm in mon_vms ~}
        ${vm.name}:
          ansible_host: ${vm.network_interface[0].nat_ip_address}
          fqdn: ${vm.fqdn}
%{ endfor ~}
    db:
      hosts:
%{ for vm in db_vms ~}
        ${vm.name}:
          ansible_host: ${vm.network_interface[0].nat_ip_address}
          fqdn: ${vm.fqdn}
%{ endfor ~}
