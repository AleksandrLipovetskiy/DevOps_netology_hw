all:
  children:
    Web:
      hosts:
%{ for vm in web_vms ~}
        ${vm.name}:
          ansible_host: ${vm.network_interface[0].nat_ip_address}
          fqdn: ${vm.fqdn}
          ansible_user: ${ansible_user}
          ansible_ssh_private_key_file: ${ansible_private_key_file}
%{ endfor ~}
    Back:
      hosts:
%{ for vm in back_vms ~}
        ${vm.name}:
          ansible_host: ${vm.network_interface[0].nat_ip_address}
          fqdn: ${vm.fqdn}
          ansible_user: ${ansible_user}
          ansible_ssh_private_key_file: ${ansible_private_key_file}
%{ endfor ~}
    Nat:
      hosts:
        ${nat_vm.name}:
          ansible_host: ${nat_vm.network_interface.nat_ip_address}
          fqdn: ${nat_vm.fqdn}
          ansible_user: ${ansible_user}
          ansible_ssh_private_key_file: ${ansible_private_key_file}
